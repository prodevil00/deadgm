{
  "name": "last-convoy",
  "version": "1.0.0",
  "private": true,
  "description": "LAST CONVOY \u2014 Mobile Apocalypse. A portrait, touch-first 3D zombie squad runner for mobile browsers (Three.js + TypeScript + esbuild).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
