    "test": "node scripts/test.mjs",
    "balance": "node scripts/test.mjs balance"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": ">=0.184.0 <0.190.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
